# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Supabase (storefront + admin dashboard) ---
# Project URL and public anon key. Safe to ship in the client (RLS enforces access).
# Find these in Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://altgclsxeslluxcqybnq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Qv26PLT14XaDqQwSO5qB2A_a55Kjvog

# --- Server-only secrets (NEVER expose to the client; used by Edge Functions) ---
# SUPABASE_SERVICE_ROLE_KEY — Supabase → Settings → API (service_role).
# CHAPA_SECRET_KEY — Chapa dashboard. CHAPA_WEBHOOK_SECRET — for verifying webhooks.
# SUPABASE_SERVICE_ROLE_KEY="..."
# CHAPA_SECRET_KEY="CHASECK_TEST-..."
# CHAPA_WEBHOOK_SECRET="..."
